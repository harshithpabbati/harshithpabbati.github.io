{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "harshithpabbati",
  "compatibility_date": "2026-02-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "not_found_handling": "none",
    "binding": "ASSETS",
    "directory": "./dist"
  }
}
