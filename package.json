{
  "name": "harshithpabbati.github.io",
  "private": true,
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "vinext lint",
    "deploy": "npx @vinext/cloudflare deploy",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json --experimental-warm-cdn-cache"
  },
  "dependencies": {
    "@vinext/cloudflare": "1.2.0",
    "clsx": "^2.1.1",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261023.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vinext": "^1.3.0",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  },
  "type": "module"
}
